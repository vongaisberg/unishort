{{#*inline "page"}}
<div class="hero">
    <h1 class="hero-title"><span class="gradient-text">Make your URLs this <span
                class="non-transparent">🤏</span> short</span></h1><br>
    <span class="subtitle">pinch.to produces the shortest links in the world by using the full spectrum of unicode characters.</span>
    <div id="box">
        <form action="/" method="post">
            <!-- <label for="url_long">Enter your long URL here:</label> -->
            <input placeholder="Paste your long URL here" pattern="\s*\S+[.:]\S+\s*" title="A web address, like example.com/page" required autofocus id="url_long"
                name="url_long">
            <button id="submit" type="submit">Shorten Now!</button>
        </form>
        {{#if error}}<p class="error">{{error}}</p>{{/if}}
    </div>


</div>

<div class="results-scroll">
    <div class="results">
        <b class="results-head">Recently shortened URLs</b>
                <table class="results-table {{new}}">
                    <tr class="header">
                        <th class="short_url">Short Link</th>
                        <th class="long_url">Original Link</th>
                        <th class="qr">QR</th>
                        <th class="clicks">Clicks</th>
                        <th class="date">Date</th>
                    </tr>
                    {{#each links}}
                    <tr class="body">
                        <td class="short_url"><input class="short_url" type="text" aria-label="Shortened URL"
                                value="{{../server_url}}/{{short_url}}" readonly>
                            <img class="copy" src="/static/copy.svg"
                                alt="{{../server_url}}/{{short_url}}">
                        </td>
                        <td class="long_url">
                            <span class="no_linebreak">
                                {{#if favicon_host}}<img class="favicon" src="/favicon/{{favicon_host}}" alt="" />{{/if}}
                                <a href="{{../server_url}}/{{short_url}}" rel="ugc nofollow">{{display_url}}</a>
                            </span>
                        </td>
                        <td class="qr"><img class="qr" src="/qr/{{short_url}}" alt="">
                        </td>
                        <td class="clicks">{{clicks}}</td>
                        <td class="date"><span class="timestamp">{{timestamp}}</span></td>
                    </tr>
                    {{/each}}

                </table>
    </div>
</div>
{{!-- <p class="bottom">
    So far, <b>{{url_counter}}</b> short URLs have been created.
</p> --}}
{{/inline}}
{{> layout title="pinch.to - Shortest URL Shortener in the World"
description="🤏.to produces the shortest URLs in the world by using the full unicode spectrum."}}