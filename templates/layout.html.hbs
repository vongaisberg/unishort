<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="color-scheme" content="light dark">
    <link rel="canonical" href="https://pinch.to{{ path }}">
    <link rel="stylesheet" href="{{{asset "styles.css"}}}">
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="pinch.to">
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="https://pinch.to{{ path }}">
    <meta name="twitter:card" content="summary">
    <script src="{{{asset "app.js"}}}" defer></script>
</head>

<body>
    <header class="site-header">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">🤏</span>pinch.to</a>
        <nav class="site-nav">
            <a href="/blog/shortest-url-shorteners">Comparison</a>
            <a href="/blog/about">About</a>
            <a href="https://github.com/vongaisberg/unishort">GitHub</a>
        </nav>
    </header>
    <main>
        {{~> page}}
    </main>
    <footer class="site-footer">
        <p>pinch.to, the shortest URL shortener. Free, no account, no trackers.</p>
        <p><a href="/blog/shortest-url-shorteners">Comparison</a> · <a href="/blog/about">About</a> ·
            <a href="https://github.com/vongaisberg/unishort">Source on GitHub</a></p>
    </footer>
</body>

</html>
